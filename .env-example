# =========================
# LLM プロバイダ
# =========================
# 既定はローカル (Ollama)。回数制限が無く、鍵も要らない。
# 一覧と各社の無料枠は `python -m toka.llm --list` で見られる。
#
#   ollama    ローカル。回数無制限（既定）
#   lmstudio  ローカル。回数無制限
#   cerebras  無料枠 30 RPM / 1M tok/日。クレカ不要
#   groq      無料枠 30 RPM / 14,400 req/日。クレカ不要
#   gemini    無料枠 5 RPM（1リクエスト13秒間隔になるので会話には不向き）
#
# モデルは「ツール呼び出しが確実に通るもの」を選ぶこと。実測では
# llama3.1:8b が 4/4 成功、qwen2.5:14b は 0/4（Ollama 上でツールの
# テンプレートが壊れており、区切りが化けて生テキストが漏れる）。
# 推論モデル（qwen3 など）は初トークンまで 10 秒かかるので避ける。
# 確認は `python -m toka.llm --provider ollama --model <名前> --smoke`。
# TOKA_LLM_PROVIDER=ollama
# TOKA_LLM_MODEL=llama3.1:8b

# 裏方（感情推定・エピソード要約・検索結果の要約）に使うプロバイダ。
# 未指定なら主応答と同じものを兼用する。
# TOKA_LLM_SUB_PROVIDER=
# TOKA_LLM_SUB_MODEL=

# 主応答が落ちたときの逃げ先。未指定なら作らない。
# ローカルを主、クラウド無料枠を保険にする構成にできる。
# TOKA_LLM_FALLBACK_PROVIDER=cerebras
# TOKA_LLM_FALLBACK_MODEL=

# =========================
# API キー（使うプロバイダのものだけ）
# =========================
# ローカル運用なら、ここは全部空のままで動く。
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=

# Web検索ツール (search_web) に必要。https://tavily.com で無料取得（クレカ不要）。
# 未設定でも起動する。検索を頼まれたときだけ「未設定です」と答える。
# TAVILY_API_KEY=

# =========================
# 以下は任意。既定値のままで動く
# =========================

# 音声認識エンジン。sherpa (ReazonSpeech) / whisper (旧経路、比較用)
# TOKA_STT_ENGINE=sherpa

# 感情の更新方法。
#   tool     応答と同じリクエスト内で feel ツールを呼ばせる（API消費 0 回）
#   separate 軽量モデルへ別途投げる（精度は上だが 1 ターンに 1 回消費する）
#   keyword  キーワード加点のみ（LLM を使わない）
# ローカルモデルでツール呼び出しが不安定なら separate にする。
# TOKA_EMOTION_MODE=tool

# 声紋照合の閾値。python -m toka.services.auth で分布を見て決める。
# TOKA_VOICE_THRESHOLD=0.45

# 声紋登録の本数と長さは toka/config.py の VOICE_ENROLL_* で調整する。
# 長さは固定していない（「以上」と言うか、何かキーを押すまで録り続ける）。

# 0 にすると声紋照合を通さず全発話を受け付ける（デバッグ用）。
# ただし自分の合成音声も通ってしまい、自分の声で自分を止めることがある。
# TOKA_VOICE_AUTH=1

# 0 にすると自分から話しかけなくなる。
# TOKA_PROACTIVE=1

# VOICEVOX
# VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_SPEAKER_ID=6
