# 必須
GEMINI_API_KEY=your_key_here

# --- 以下は任意。既定値のままで動く ---

# Gemini の 1 分あたりリクエスト上限。無料枠の gemini-2.5-flash は 5。
# 有料枠に上げたらここを上げる。超過すると 429 で待たされる。
# TOKA_GEMINI_RPM=5

# 音声認識エンジン。sherpa (ReazonSpeech) / whisper (旧経路、比較用)
# TOKA_STT_ENGINE=sherpa

# 感情の更新方法。
#   tool     応答と同じリクエスト内で feel ツールを呼ばせる（API消費 0 回）
#   separate 軽量モデルへ別途投げる（精度は上だが 1 ターンに 1 回消費する）
#   keyword  キーワード加点のみ（API を使わない）
# TOKA_EMOTION_MODE=tool

# 声紋照合の閾値。python -m toka.services.auth で分布を見て決める。
# TOKA_VOICE_THRESHOLD=0.45

# 0 にすると声紋照合を通さず全発話を受け付ける（デバッグ用）。
# TOKA_VOICE_AUTH=1

# 0 にすると自分から話しかけなくなる。
# TOKA_PROACTIVE=1

# VOICEVOX
# VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_SPEAKER_ID=6
